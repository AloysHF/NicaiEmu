# Auto detect text files and perform LF normalization
* text=auto

# Rust sources
*.rs text diff=rust

# TOML
*.toml text

# Markdown
*.md text diff=markdown

# Shell scripts
*.sh text eol=lf

# Windows batch
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.CBE binary
